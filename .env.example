# ── Supabase ──────────────────────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API

# Public anon key — safe to expose in browser code
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Demo (optional) ───────────────────────────────────────────────────────────
# Shows "Try the demo" on the sign-in page. Sign-in happens on the server,
# so the passwords never reach the browser.
# NEXT_PUBLIC_DEMO_ENABLED=true
# DEMO_OWNER_EMAIL=
# DEMO_OWNER_PASSWORD=
# DEMO_EMPLOYEE_EMAIL=
# DEMO_EMPLOYEE_PASSWORD=
